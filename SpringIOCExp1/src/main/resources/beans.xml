<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:aop="http://www.springframework.org/schema/aop"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
		http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop-4.0.xsd">
	
	<bean id="odr1" class="com.test.Order1" autowire="byType">
		<property name="id" value="1"></property>
		<property name="name" value="apple"></property>
		<property name="price" value="200"></property>
	</bean>
	
	<bean id="odr2" class="com.test.Order1">
		<property name="id" value="2"></property>
		<property name="name" value="mango"></property>
		<property name="price" value="500"></property>
	</bean>
	
	<bean id="odr3" class="com.test.Order1">
		<constructor-arg name="id" value="3"></constructor-arg>
		<constructor-arg name="name" value="banana"></constructor-arg>
		<constructor-arg name="price" value="100"></constructor-arg>
	</bean>
	
	<bean id="addr1" class="com.test.Address">
		<property name="city" value="Mumbai"></property>
		<property name="state" value="Maharashtra"></property>
	</bean>
	
	<bean id="addr2" class="com.test.Address">
		<property name="city" value="Surat"></property>
		<property name="state" value="Gujarat"></property>
	</bean>
	
	<bean id="addr3" class="com.test.Address">
		<constructor-arg name="city" value="Bangalore"></constructor-arg>
		<constructor-arg name="stste" value="Karnataka"></constructor-arg>
		
	</bean>
	
	<bean id="cust1" class="com.test.Customer">
		<property name="id" value="1"></property>
		<property name="name" value="Rohit"></property>
		<property name="adrs">
			<list>
				<ref bean="addr1" />
				<ref bean="addr2" />
			</list>
		</property>
		<property name="orders">
			<list>
				<ref bean="odr1" />
				<ref bean="odr2" />
			</list>
		</property>
	</bean>
	
	<bean id="cust2" class="com.test.Customer">
		<constructor-arg name="id" value="2"></constructor-arg>
		<constructor-arg name="name" value="Kohli"></constructor-arg>
		<constructor-arg name="adrs">
			<list>
				<ref bean="addr3" />
			</list>
		</constructor-arg>
		<constructor-arg name="orders">
			<list>
				<ref bean="odr3" />
			</list>
		</constructor-arg>
	</bean>
	
</beans>
